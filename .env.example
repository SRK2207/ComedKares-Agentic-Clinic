# ==============================================================================
# ComedKares Environment Variables
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Gemini API Key (Gemini 2.5 Flash / 2.0 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration (Multi-tenant DB & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Razorpay Test Mode Credentials
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret

# Optional Real Physical SMS Gateway (MSG91)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_dlt_template_id_here

# Demo / Fallback Mode (Enables instant demo OTP and in-memory multi-tenant store if keys are unset)
DEMO_MODE=true
